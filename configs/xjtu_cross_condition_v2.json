  "status": "preregistered_not_run",
  "research_question": "Does the frozen relative-temporal State Interpreter transfer to a newly learned z=8 latent space under 37.5Hz11kN?",
  "source_condition": "35Hz12kN",
  "target_condition": "37.5Hz11kN",
  "scope": "Interpreter transfer with a condition-specific AutoEncoder; not whole-system zero-shot transfer.",
  "data_split": {
    "train_bearings": [
      "Bearing2_1",
      "Bearing2_2",
      "Bearing2_3"
