    "validation_bearing": "Bearing2_4",
    "strict_blind_holdout": "Bearing2_5"
  },
  "blind_holdout_audit": {
    "raw_directory_and_schema_inspected": true,
    "signal_statistics_inspected": false,
    "latent_or_state_outputs_inspected": false
