  "preprocessing": {
    "n_fft": 1024,
    "win_length": 1024,
    "hop_length": 512,
    "window": "hann",
    "magnitude_transform": "log1p",
    "output_shape": [2, 32, 32],
    "normalization_fit_on": [
      "Bearing2_1",
      "Bearing2_2",
      "Bearing2_3"
    ]
  },
  "autoencoder": {
    "architecture": "SmallConvAutoEncoder",
    "embedding_dim": 8,
    "epochs": 5,
    "batch_size": 32,
    "learning_rate": 0.001,
    "seed": 20260801,
    "weights": "train_new_on_target_condition"
  },
  "interpreter": {
    "type": "RelativeTemporalStateInterpreter",
    "calibration_steps": 15,
    "temporal_window": 10,
    "state_fields": ["level", "trend", "movement"],
    "parameters_may_be_tuned": false
  },
  "primary_analysis": {
    "metric": "level_spearman_rho_vs_normalized_lifetime",
    "strong_support_threshold": 0.7,
