{
  "experiment_id": "xjtu_condition3_feature_lstm_development_v1",
  "status": "preregistered_preflight_no_condition3_data_read",
  "research_question": "Can a domain-informed 65-feature temporal baseline learn a consistently ordered health-progress representation across unseen Condition 3 bearings?",
  "condition": "40Hz10kN",
  "split": {
    "development": ["Bearing3_1", "Bearing3_2", "Bearing3_3"],
    "validation": ["Bearing3_4"],
    "blind": ["Bearing3_5"]
  },
  "outer_lobo_folds": [
    {"test": "Bearing3_1", "train": ["Bearing3_2", "Bearing3_3"]},
    {"test": "Bearing3_2", "train": ["Bearing3_1", "Bearing3_3"]},
    {"test": "Bearing3_3", "train": ["Bearing3_1", "Bearing3_2"]}
  ],
  "features": {
    "count": 65,
    "time_domain": 37,
    "frequency_domain": 28,
    "calibration_steps": 15,
    "window_size": 10
  },
  "model": {
    "architecture": "FeatureLSTM",
    "n_features": 65,
    "hidden_size": 16,
    "dense_size": 16,
    "dropout": 0.2,
    "bidirectional": true,
    "pytorch_parameter_count": 11169
  },
  "training": {
    "target": "normalized_remaining_useful_life",
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss": "HuberLoss",
    "huber_delta": 0.08,
    "batch_size": 32,
    "fixed_epochs": 50,
    "checkpoint_selection": "fixed_final_epoch_no_outer_test_selection",
    "seeds": [20260918, 20260921, 20260924]
  },
  "evaluation": {
    "primary_unit": "bearing",
    "primary_metric": "spearman_progress",
    "reported_state_score": "1_minus_clipped_predicted_rul",
    "secondary_metrics": ["backward_step_fraction", "seed_standard_deviation"],
    "no_pooled_primary_metric": true,
    "validation_gate": {
      "all_three_mean_spearman_positive": true,
      "at_least_two_mean_spearman_at_least": 0.5,
      "minimum_positive_seeds_per_bearing": 2
    }
  },
  "materialization": {
    "cache_schema": "xjtu_feature_cache_v1",
    "format": "one_npz_per_bearing_plus_json_manifest",
    "required_npz_fields": ["features", "step_ids", "source_paths"],
    "cache_directory": "cache/xjtu_condition3_feature_lstm_v1",
    "quality_checks": [
      "finite_65_features",
      "numeric_unique_steps",
      "sample_count_per_bearing",
      "constant_or_near_constant_features",
      "early_calibrated_absolute_quantiles"
    ]
  },
  "tokens": {
    "materialize_development": "MATERIALIZE_BEARING3_1_TO_3_FEATURES_ONCE",
    "train_development": "TRAIN_FEATURE_LSTM_DEVELOPMENT_LOBO_ONCE"
